# Copy to .env and fill in ONE provider key. Never commit .env.

# Primary model (provider: anthropic | openai | gemini)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5

# Fallback used if the primary fails (provider error / unusable JSON)
FALLBACK_LLM_PROVIDER=anthropic
FALLBACK_LLM_MODEL=claude-sonnet-5-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional tuning (defaults shown)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=4096
# MAX_CONTENT_CHARS=12000
# EXTRA_PAGES=2
# CACHE_TTL_SECONDS=86400
# FETCH_READ_TIMEOUT_SECONDS=10
